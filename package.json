    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "latest",
    "electron": "latest",
    "wait-on": "latest"
  }
}
